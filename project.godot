; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=4

_global_script_classes=[ {
"base": "Reference",
"class": "CardData",
"language": "GDScript",
"path": "res://engine/CardData.gd"
}, {
"base": "Reference",
"class": "CardDatabase",
"language": "GDScript",
"path": "res://engine/CardDatabase.gd"
}, {
"base": "Reference",
"class": "Deck",
"language": "GDScript",
"path": "res://engine/Deck.gd"
}, {
"base": "Node",
"class": "GameConstants",
"language": "GDScript",
"path": "res://engine/GameConstants.gd"
}, {
"base": "Reference",
"class": "GameState",
"language": "GDScript",
"path": "res://engine/GameState.gd"
}, {
"base": "Reference",
"class": "Hand",
"language": "GDScript",
"path": "res://engine/Hand.gd"
}, {
"base": "Node",
"class": "LocalGameEngine",
"language": "GDScript",
"path": "res://engine/LocalGameEngine.gd"
}, {
"base": "Reference",
"class": "PlayerData",
"language": "GDScript",
"path": "res://engine/PlayerData.gd"
}, {
"base": "Reference",
"class": "RoadTo100AI",
"language": "GDScript",
"path": "res://engine/RoadTo100AI.gd"
} ]
_global_script_class_icons={
"CardData": "",
"CardDatabase": "",
"Deck": "",
"GameConstants": "",
"GameState": "",
"Hand": "",
"LocalGameEngine": "",
"PlayerData": "",
"RoadTo100AI": ""
}

[application]

config/name="Road To 100"
run/main_scene="res://MainMenu.tscn"
boot_splash/fullsize=false
boot_splash/use_filter=false
boot_splash/bg_color=Color( 0, 0, 0, 1 )
config/icon="res://icon.png"

[audio]

default_bus_layout="res://default_env.tres"

[autoload]

GlobalsUtilities="*res://GlobalsUtilities.gd"
AudioManager="*res://AudioManager.tscn"

[display]

window/size/width=1920
window/size/height=1080
window/size/resizable=false
window/size/fullscreen=true
window/size/test_width=1920
window/size/test_height=1080
window/handheld/orientation="sensor_landscape"
window/stretch/mode="2d"
window/stretch/aspect="keep"

[physics]

common/enable_pause_aware_picking=true

[rendering]

gles2/compatibility/enable_high_float.Android=true
environment/default_environment="res://default_env.tres"
